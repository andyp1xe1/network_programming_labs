# Server basics
HTTP_DIRECTORY=/workspace/packages/www
HTTP_PORT=8888

# Performance settings
HTTP_RATE_LIMIT=5
HTTP_DELAY=0.1
HTTP_LISTEN_QUEUE=5

# Development/testing options
HTTP_UNSAFE_COUNTING=false
HTTP_NO_DELAY=false

# For race condition demonstration:
# HTTP_UNSAFE_COUNTING=true
# HTTP_DELAY=0.5
# HTTP_RATE_LIMIT=20
